{
	"name": "jj-range-diff",
	"displayName": "JJ Range Diff",
	"version": "0.0.7",
	"private": true,
	"description": "Open JJ multi-diff views for revision ranges.",
	"repository": {
		"type": "git",
		"url": "https://github.com/astahmer/jj-range-diff.git"
	},
	"categories": [
		"Other",
		"Programming Languages",
		"Visualization"
	],
	"publisher": "astahmer",
	"activationEvents": [
		"onUri",
		"onStartupFinished"
	],
	"main": "./extension.js",
	"bin": {
		"jj-range-diff": "./bin.js"
	},
	"devDependencies": {
		"@vscode/vsce": "3.7.1"
	},
	"contributes": {
		"commands": [
			{
				"command": "jj-range-diff.openRangeMultiDiff",
				"title": "JJ: Open Range Multi Diff"
			},
			{
				"command": "jj-range-diff.openFileRevisionTimeline",
				"title": "JJ: Open File Revision Timeline"
			}
		]
	},
	"engines": {
		"vscode": "^1.86.0"
	},
	"scripts": {
		"build": "pnpx @vscode/vsce package --skip-license",
		"test": "node --test"
	}
}
