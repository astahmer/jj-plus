{
	"name": "jj-plus",
	"displayName": "JJ Plus",
	"version": "0.10.9",
	"description": "Explore JJ file and repository timelines, then open focused multi-diff views.",
	"categories": [
		"Other",
		"Programming Languages",
		"Visualization"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/astahmer/jj-plus.git"
	},
	"publisher": "astahmer",
	"bin": {
		"jj-plus": "./dist/bin.cjs"
	},
	"files": [
		"dist/",
		"webview-dist/",
		"assets/",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./dist/extension/index.cjs",
	"scripts": {
		"bddgen": "bddgen",
		"build": "pnpm build:extension && pnpm build:webview && pnpm vsce package --skip-license --no-dependencies",
		"build:extension": "tsdown",
		"build:integration": "tsdown --config ./tests/vscode/tsdown.config.ts",
		"build:webview": "vite build",
		"dev": "vite --host 127.0.0.1 --open /",
		"fixtures:e2e": "node ./tests/fixtures/generate-e2e-fixtures.ts",
		"fmt": "oxfmt --write",
		"lint": "pnpm lint:ox && pnpm lint:knip",
		"lint:fix": "pnpm lint:ox --fix && pnpm lint:knip --fix",
		"lint:knip": "knip",
		"lint:ox": "oxlint . --disable-nested-config",
		"pkg": "bun build src/bin.ts --compile --outfile jjdiff ",
		"release": "node --env-file-if-exists .env scripts/release.mjs",
		"release:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"release:dry-run": "node scripts/release.mjs --dry-run",
		"release:prepare": "node scripts/release-prepare.mjs",
		"release:publish": "pnpm release:check && pnpm exec vsce publish --no-dependencies --skip-duplicate --githubBranch main",
		"release:publish:npm": "pnpm release:check && pnpm publish --access public --provenance",
		"seed:test-repo": "node ./scripts/seed-test-repo.mjs",
		"test": "node --test tests/units/**/*.test.ts && pnpm test:webview",
		"test:all": "pnpm test && pnpm test:e2e && pnpm test:integration",
		"test:e2e": "pnpm build:extension && pnpm fixtures:e2e && pnpm bddgen && playwright test",
		"test:integration": "pnpm build:extension && pnpm build:webview && pnpm build:integration && pnpm fixtures:e2e && node ./tests/vscode/run.ts",
		"test:webview": "vitest run --config webview/vitest.config.ts",
		"typecheck": "pnpm typecheck:web && pnpm typecheck:extension",
		"typecheck:extension": "tsgo --noEmit -p tsconfig.node.json",
		"typecheck:web": "tsgo --noEmit -p tsconfig.json",
		"watch": "pnpm build:extension --watch"
	},
	"dependencies": {
		"@effect/platform-browser": "4.0.0-beta.97",
		"@pierre/diffs": "1.3.6",
		"effect": "4.0.0-beta.97",
		"foldkit": "0.130.0"
	},
	"devDependencies": {
		"@foldkit/vite-plugin": "0.11.0",
		"@playwright/test": "1.62.1",
		"@types/mocha": "10.0.10",
		"@types/node": "26.4.0",
		"@types/vscode": "1.134.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vscode/test-electron": "3.1.0",
		"@vscode/vsce": "3.9.2",
		"knip": "6.32.3",
		"mocha": "11.8.0",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"playwright-bdd": "9.2.0",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	},
	"contributes": {
		"configuration": {
			"title": "JJ Plus",
			"properties": {
				"jjplus.currentLineBlame": {
					"type": "boolean",
					"default": true,
					"description": "Show GitLens-style current-line blame as a non-editing end-of-line annotation."
				},
				"jjplus.inlineBlameGutter": {
					"type": "boolean",
					"default": false,
					"description": "Show inline blame annotations for many lines (can be dense)."
				},
				"jjplus.inlineBlameSparse": {
					"type": "boolean",
					"default": true,
					"description": "When inline blame is on, only annotate revision hunk starts."
				},
				"jjplus.blameHoverMode": {
					"type": "string",
					"enum": [
						"blame",
						"any",
						"never"
					],
					"enumDescriptions": [
						"Show the popover only when hovering a blame annotation (default).",
						"Show the popover when hovering any position in a file.",
						"Never show the blame popover."
					],
					"default": "blame",
					"description": "Controls when JJ Plus shows the line-blame popover."
				},
				"jjplus.hoverTimelineLink": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Deprecated: use `jjplus.blameHoverMode` instead. `false` maps to `never`; `true` maps to `blame`."
				},
				"jjplus.statusBarChangeChip": {
					"type": "boolean",
					"default": true,
					"description": "Show working-copy change id on the status bar."
				},
				"jjplus.scmChangedLines": {
					"type": "boolean",
					"default": false,
					"description": "Decorate lines changed vs @- in the editor."
				},
				"jjplus.opLogWatch": {
					"type": "boolean",
					"default": false,
					"description": "Watch jj op log and toast when another tool mutates the repo."
				},
				"jjplus.conflictHelper": {
					"type": "boolean",
					"default": true,
					"description": "Highlight jj conflict markers and enable jump-next."
				},
				"jjplus.codeActions": {
					"type": "boolean",
					"default": false,
					"description": "Offer Code Actions like “Why is this line here?”."
				}
			}
		},
		"commands": [
			{
				"command": "jj-plus.openRangeMultiDiff",
				"title": "JJ Plus: Open Range Multi Diff"
			},
			{
				"command": "jj-plus.openFileRangeDiff",
				"title": "JJ Plus: Open File Diff Between Revisions"
			},
			{
				"command": "jj-plus.openBlameRevisionDiff",
				"title": "JJ Plus: Open Blame Revision Diff"
			},
			{
				"command": "jj-plus.openChangesWithPrevious",
				"title": "JJ Plus: Open Changes with Previous Revision",
				"icon": "$(history)"
			},
			{
				"command": "jj-plus.openFileRevisionTimeline",
				"title": "JJ Plus: Open Revision Timeline",
				"icon": "$(diff)"
			},
			{
				"command": "jj-plus.openRepoTimeline",
				"title": "JJ Plus: Open Repo Timeline",
				"icon": "$(timeline-view-icon)"
			},
			{
				"command": "jj-plus.openRevisionDiffPrevious",
				"title": "JJ Plus: Open Previous Revision Diff",
				"icon": "$(arrow-left)",
				"enablement": "jjplus.revisionDiffHasPrevious"
			},
			{
				"command": "jj-plus.openRevisionDiffNext",
				"title": "JJ Plus: Open Next Revision Diff",
				"icon": "$(arrow-right)",
				"enablement": "jjplus.revisionDiffHasNext"
			},
			{
				"command": "jj-plus.openRevisionDiffTimeline",
				"title": "JJ Plus: Open Timeline from Revision Diff",
				"icon": "$(timeline-view-icon)"
			},
			{
				"command": "jj-plus.toggleLineBlame",
				"title": "JJ Plus: Toggle Line Blame"
			},
			{
				"command": "jj-plus.compareWithBookmark",
				"title": "JJ Plus: Compare File with Bookmark / Branch",
				"icon": "$(git-compare)"
			},
			{
				"command": "jj-plus.peekRevisionAtCursor",
				"title": "JJ Plus: Peek Revision at Cursor"
			},
			{
				"command": "jj-plus.openFileAtRevision",
				"title": "JJ Plus: Open File at Revision"
			},
			{
				"command": "jj-plus.openWorkingCopyChangesMulti",
				"title": "JJ Plus: Open Working Copy Changes vs Previous"
			},
			{
				"command": "jj-plus.jumpNextConflict",
				"title": "JJ Plus: Jump to Next Conflict Marker"
			},
			{
				"command": "jj-plus.openFileLineTimeline",
				"title": "JJ Plus: Open Timeline for Selected Lines"
			},
			{
				"command": "jj-plus.openTimelineAtLine",
				"title": "JJ Plus: Open Timeline at Cursor Line"
			},
			{
				"command": "jj-plus.clearLineHistory",
				"title": "JJ Plus: Clear Line History Filter"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "jj-plus.openTimelineAtLine",
					"group": "navigation@90",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-plus.openFileLineTimeline",
					"group": "navigation@91",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-plus.openChangesWithPrevious",
					"group": "navigation@92",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-plus.compareWithBookmark",
					"group": "navigation@93",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-plus.peekRevisionAtCursor",
					"group": "navigation@94",
					"when": "resourceScheme == file"
				}
			],
			"editor/title": [
				{
					"command": "jj-plus.openChangesWithPrevious",
					"group": "navigation@1",
					"when": "resourceScheme == file && !jjplus.revisionDiffActive"
				},
				{
					"command": "jj-plus.openFileRevisionTimeline",
					"group": "navigation@2",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-plus.compareWithBookmark",
					"group": "navigation@3",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-plus.openRevisionDiffPrevious",
					"group": "navigation@4",
					"when": "jjplus.revisionDiffActive"
				},
				{
					"command": "jj-plus.openRevisionDiffNext",
					"group": "navigation@5",
					"when": "jjplus.revisionDiffActive"
				},
				{
					"command": "jj-plus.openRevisionDiffTimeline",
					"group": "navigation@6",
					"when": "jjplus.revisionDiffActive"
				}
			],
			"editor/title/context": [
				{
					"command": "jj-plus.openFileRevisionTimeline",
					"group": "zz_jjplus@1",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-plus.openTimelineAtLine",
					"group": "zz_jjplus@2",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-plus.openChangesWithPrevious",
					"group": "zz_jjplus@3",
					"when": "resourceScheme == file"
				}
			]
		}
	},
	"activationEvents": [
		"onStartupFinished",
		"onUri"
	],
	"icon": "assets/jj-plus-icon.png",
	"engines": {
		"vscode": "^1.134.0"
	},
	"packageManager": "pnpm@12.0.0"
}
