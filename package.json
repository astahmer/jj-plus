{
	"name": "visualjj-range-diff-helper",
	"displayName": "VisualJJ Range Diff Helper",
	"version": "0.0.3",
	"private": true,
	"description": "Open JJ multi-diff views for revision ranges.",
	"repository": {
		"type": "git",
		"url": "https://github.com/astahmer/visualjj-range-diff-helper.git"
	},
	"categories": [
		"Other",
		"Programming Languages",
		"Visualization"
	],
	"publisher": "astahmer",
	"activationEvents": [
		"onUri",
		"onStartupFinished"
	],
	"main": "./extension.js",
	"bin": {
		"visualjj-range-diff-helper": "./bin.js"
	},
	"devDependencies": {
		"@vscode/vsce": "3.7.1"
	},
	"contributes": {
		"commands": [
			{
				"command": "visualjj.openRangeMultiDiff",
				"title": "VisualJJ: Open Range Multi Diff"
			}
		]
	},
	"engines": {
		"vscode": "^1.86.0"
	},
	"scripts": {
		"build": "pnpx @vscode/vsce package --skip-license"
	}
}
