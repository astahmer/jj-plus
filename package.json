{
	"name": "jj-range-diff",
	"displayName": "JJ Range Diff",
	"version": "0.0.2",
	"private": true,
	"description": "Open JJ multi-diff views for revision ranges.",
	"scripts": {
		"build": "pnpm build:webview && pnpm vsce package --skip-license --no-dependencies",
		"build:webview": "vite build",
		"dev": "vite --host 127.0.0.1 --open /",
		"bddgen": "bddgen",
		"fixtures:e2e": "node ./scripts/generate-e2e-fixtures.mjs",
		"test": "node --test",
		"test:e2e": "pnpm fixtures:e2e && pnpm bddgen && playwright test",
		"test:integration": "pnpm build:webview && pnpm fixtures:e2e && node ./integration/vscode/run.js",
		"test:all": "pnpm test && pnpm test:e2e && pnpm test:integration",
		"typecheck": "tsc --noEmit"
	},
	"main": "./extension.js",
	"bin": {
		"jj-range-diff": "./bin.js"
	},
	"contributes": {
		"commands": [
			{
				"command": "jj-range-diff.openRangeMultiDiff",
				"title": "JJ: Open Range Multi Diff"
			},
			{
				"command": "jj-range-diff.openFileRevisionTimeline",
				"title": "JJ: Open File Revision Timeline"
			}
		]
	},
	"dependencies": {
		"solid-js": "^1.9.9"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@types/node": "^24.5.2",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "3.7.1",
		"mocha": "^11.7.5",
		"playwright-bdd": "^8.4.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-solid": "^2.11.8"
	},
	"engines": {
		"vscode": "^1.86.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/astahmer/jj-range-diff.git"
	},
	"categories": [
		"Other",
		"Programming Languages",
		"Visualization"
	],
	"publisher": "astahmer",
	"activationEvents": [
		"onUri",
		"onStartupFinished"
	]
}
