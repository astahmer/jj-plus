{
	"name": "jj-range-diff",
	"displayName": "JJ Range Diff",
	"version": "0.10.3",
	"private": true,
	"description": "Open JJ multi-diff views for revision ranges.",
	"categories": [
		"Other",
		"Programming Languages",
		"Visualization"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/astahmer/jj-range-diff.git"
	},
	"publisher": "astahmer",
	"bin": {
		"jj-range-diff": "./dist/bin.cjs"
	},
	"type": "module",
	"main": "./dist/extension/index.cjs",
	"scripts": {
		"bddgen": "bddgen",
		"build": "pnpm build:extension && pnpm build:webview && pnpm vsce package --skip-license --no-dependencies",
		"build:extension": "tsdown",
		"build:integration": "tsdown --config ./tests/vscode/tsdown.config.ts",
		"build:webview": "vite build",
		"dev": "vite --host 127.0.0.1 --open /",
		"fixtures:e2e": "node ./tests/fixtures/generate-e2e-fixtures.ts",
		"fmt": "oxfmt --write",
		"lint": "pnpm lint:ox && pnpm lint:knip",
		"lint:fix": "pnpm lint:ox --fix && pnpm lint:knip --fix",
		"lint:knip": "knip",
		"lint:ox": "oxlint .",
		"pkg": "bun build src/bin.ts --compile --outfile jjdiff ",
		"seed:test-repo": "node ./scripts/seed-test-repo.mjs",
		"test": "node --test tests/units/**/*.test.ts && pnpm test:webview",
		"test:all": "pnpm test && pnpm test:e2e && pnpm test:integration",
		"test:e2e": "pnpm build:extension && pnpm fixtures:e2e && pnpm bddgen && playwright test",
		"test:integration": "pnpm build:extension && pnpm build:webview && pnpm build:integration && pnpm fixtures:e2e && node ./tests/vscode/run.ts",
		"test:webview": "vitest run --config webview/vitest.config.ts",
		"typecheck": "pnpm typecheck:web && pnpm typecheck:extension",
		"typecheck:extension": "tsgo --noEmit -p tsconfig.node.json",
		"typecheck:web": "tsgo --noEmit -p tsconfig.json",
		"watch": "pnpm build:extension --watch"
	},
	"dependencies": {
		"@effect/platform-browser": "4.0.0-beta.97",
		"@pierre/diffs": "^1.2.12",
		"effect": "4.0.0-beta.97",
		"foldkit": "0.130.0"
	},
	"devDependencies": {
		"@foldkit/vite-plugin": "0.11.0",
		"@playwright/test": "1.59.1",
		"@types/mocha": "10.0.10",
		"@types/node": "25.6.0",
		"@types/vscode": "1.115.0",
		"@vscode/test-electron": "2.5.2",
		"@vscode/vsce": "3.7.1",
		"knip": "6.4.1",
		"mocha": "11.7.5",
		"oxfmt": "0.44.0",
		"oxlint": "1.59.0",
		"playwright-bdd": "8.5.0",
		"tsdown": "0.15.4",
		"typescript": "6.0.2",
		"vite": "8.0.8",
		"vitest": "^4.1.10"
	},
	"contributes": {
		"commands": [
			{
				"command": "jj-range-diff.openRangeMultiDiff",
				"title": "JJ: Open Range Multi Diff"
			},
			{
				"command": "jj-range-diff.openFileRangeDiff",
				"title": "JJ: Open File Diff Between Revisions"
			},
			{
				"command": "jj-range-diff.openFileRevisionTimeline",
				"title": "JJ: Open File Revision Timeline"
			},
			{
				"command": "jj-range-diff.openFileLineTimeline",
				"title": "JJ: Open Timeline for Selected Lines"
			},
			{
				"command": "jj-range-diff.openTimelineAtLine",
				"title": "JJ: Open Timeline at Cursor Line"
			},
			{
				"command": "jj-range-diff.clearLineHistory",
				"title": "JJ: Clear Line History Filter"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "jj-range-diff.openTimelineAtLine",
					"group": "navigation@90",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-range-diff.openFileLineTimeline",
					"group": "navigation@91",
					"when": "resourceScheme == file"
				}
			],
			"editor/title/context": [
				{
					"command": "jj-range-diff.openFileRevisionTimeline",
					"group": "navigation@90",
					"when": "resourceScheme == file"
				},
				{
					"command": "jj-range-diff.openTimelineAtLine",
					"group": "navigation@91",
					"when": "resourceScheme == file"
				}
			]
		}
	},
	"activationEvents": [
		"onStartupFinished",
		"onUri"
	],
	"engines": {
		"vscode": "^1.115.0"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
