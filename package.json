{
	"name": "jj-range-diff",
	"displayName": "JJ Range Diff",
	"version": "0.0.2",
	"private": true,
	"description": "Open JJ multi-diff views for revision ranges.",
	"repository": {
		"type": "git",
		"url": "https://github.com/astahmer/jj-range-diff.git"
	},
	"categories": [
		"Other",
		"Programming Languages",
		"Visualization"
	],
	"publisher": "astahmer",
	"activationEvents": [
		"onUri",
		"onStartupFinished"
	],
	"main": "./extension.js",
	"bin": {
		"jj-range-diff": "./bin.js"
	},
	"dependencies": {
		"solid-js": "^1.9.9"
	},
	"devDependencies": {
		"@vscode/vsce": "3.7.1",
		"vite": "^7.3.1",
		"vite-plugin-solid": "^2.11.8"
	},
	"contributes": {
		"commands": [
			{
				"command": "jj-range-diff.openRangeMultiDiff",
				"title": "JJ: Open Range Multi Diff"
			},
			{
				"command": "jj-range-diff.openFileRevisionTimeline",
				"title": "JJ: Open File Revision Timeline"
			}
		]
	},
	"engines": {
		"vscode": "^1.86.0"
	},
	"scripts": {
		"build": "pnpm build:webview && pnpx @vscode/vsce package --skip-license",
		"build:webview": "vite build",
		"dev:webview": "vite --host 127.0.0.1 --open /webview/index.html",
		"test": "node --test"
	}
}
