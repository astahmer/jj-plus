{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": [
			"ES2023",
			"DOM"
		],
		"strict": false,
		"noImplicitAny": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": [
			"node",
			"mocha",
			"vscode"
		]
	},
	"include": [
		"src/**/*.ts",
		"scripts/**/*.mjs",
		"test/**/*.ts",
		"integration/**/*.js",
		"tsdown.config.ts"
	],
	"exclude": [
		"node_modules",
		".e2e-runtime",
		".features-gen",
		".vscode-test",
		"test-results",
		"webview-dist"
	]
}
