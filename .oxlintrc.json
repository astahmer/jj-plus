{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		".integration-dist/**",
		".e2e-runtime/**",
		".features-gen/**",
		".direnv/**",
		".references/**",
		".vscode-test/**",
		"node_modules/**",
		"test-results/**",
		"tests/fixtures/assets/**",
		"webview-dist/**",
		"webview/public/e2e/**"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"rules": {
		"eslint/no-console": "off",
		"unicorn/require-post-message-target-origin": "off"
	}
}
