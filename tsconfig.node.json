{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023", "DOM"],
		"strict": false,
		"noImplicitAny": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node", "mocha", "vscode"]
	},
	"include": [
		"src/**/*.ts",
		"tests/fixtures/**/*.ts",
		"tests/units/**/*.ts",
		"tests/vscode/**/*.ts",
		"tsdown.config.ts"
	],
	"exclude": [
		"node_modules",
		".integration-dist",
		".e2e-runtime",
		".features-gen",
		".vscode-test",
		"test-results",
		"webview-dist"
	]
}
