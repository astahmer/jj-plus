{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"features/steps/**/*.ts",
		"integration/vscode/suite/**/*.ts",
		"integration/vscode/run.ts",
		"scripts/**/*.ts"
	],
	"project": [
		"*.ts",
		"src/**/*.ts",
		"integration/**/*.ts",
		"scripts/**/*.ts",
		"test/**/*.ts",
		"tests/**/*.ts",
		"features/**/*.ts",
		"webview/**/*.{js,ts,tsx}",
	],
	"ignore": [
		"features/support/fixtures.ts"
	]
}
