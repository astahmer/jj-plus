{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"features/steps/**/*.ts",
		"integration/vscode/suite/**/*.js"
	],
	"project": [
		"*.{mjs,ts}",
		"src/**/*.ts",
		"integration/**/*.js",
		"scripts/**/*.mjs",
		"test/**/*.ts",
		"tests/**/*.ts",
		"features/**/*.ts",
		"webview/**/*.{js,ts,tsx}",
	],
	"ignore": [
		"features/support/fixtures.ts"
	]
}
