{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"tests/features/steps/**/*.ts",
		"tests/vscode/suite/**/*.ts",
		"tests/fixtures/**/*.ts",
		"webview/src/**/*.test.ts",
		"webview/src/repo/entry.ts",
	],
	"project": ["*.ts", "src/**/*.ts", "tests/**/*.ts", "webview/**/*.{js,ts,tsx}"],
	"ignore": ["tests/fixtures/assets/**", "webview/src/vitest-setup.ts"],
	"ignoreUnresolved": ["./src/vitest-setup.ts"],
	"rules": {
		"exports": "off",
		"types": "off",
		"nsExports": "off",
		"nsTypes": "off",
		"enumMembers": "off",
		"namespaceMembers": "off",
	},
}
